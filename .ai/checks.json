{
  "schemaVersion": 4,
  "packageFallback": {
    "mode": "none",
    "scripts": []
  },
  "checks": [
    {
      "name": "system-integrity",
      "command": "node",
      "args": [
        "40-脚本/check-system.mjs"
      ],
      "profiles": [
        "quick",
        "standard",
        "controlled",
        "release"
      ],
      "covers": [
        "static",
        "architecture",
        "documentation"
      ],
      "sideEffect": "none",
      "estimatedCost": "very-low",
      "timeoutMs": 30000,
      "acceptanceMode": "none"
    },
    {
      "name": "core-tests",
      "command": "node",
      "args": [
        "40-脚本/verify-system.mjs",
        "--profile",
        "tests",
        "--group",
        "core"
      ],
      "profiles": [
        "standard",
        "controlled",
        "release"
      ],
      "covers": [
        "unit",
        "behavior"
      ],
      "sideEffect": "none",
      "estimatedCost": "low",
      "timeoutMs": 120000,
      "acceptanceMode": "none"
    },
    {
      "name": "integration-tests",
      "command": "node",
      "args": [
        "40-脚本/verify-system.mjs",
        "--profile",
        "tests",
        "--group",
        "integration"
      ],
      "profiles": [
        "controlled",
        "release"
      ],
      "covers": [
        "integration",
        "behavior",
        "negative-path"
      ],
      "sideEffect": "none",
      "estimatedCost": "medium",
      "timeoutMs": 180000,
      "acceptanceMode": "none"
    }
  ]
}
